<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>smpa_gui</name>
  <version>0.6.0</version>
  <description>Standalone browser GUI for ROS 2: graph, topics, sensors, parameters, services and actions,
    with optional SMPA views: recorded sessions, and a Dashboard that talks to SMPA's own conversation
    server (started as a separate process) and draws Sense, Belief and Plan Turtle graphs.
    Depends on no SMPA package.</description>
  <maintainer email="dorteel@gmail.com">Mark Adamik</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>unique_identifier_msgs</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>rosidl_parser</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- Web server. The tested versions are pinned in requirements.txt and installed into the
       GUI's virtual environment by install_gui.sh; see README.md, "Python environment". -->
  <exec_depend>python3-fastapi</exec_depend>
  <exec_depend>python3-uvicorn</exec_depend>
  <exec_depend>python3-websockets</exec_depend>
  <!-- Turtle parsing for the Dashboard's graph views; the same version as SMPA pins (rdflib 7.1.4). -->
  <exec_depend>python3-rdflib</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>example_interfaces</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>std_msgs</test_depend>
  <test_depend>tf2_msgs</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
